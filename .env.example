# Flask secret key (required in production)
SECRET_KEY=change-this-to-a-long-random-secret-key

# Google Gemini API (required)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model (supports audio + text) — check https://ai.google.dev/gemini-api/docs/models
# for currently supported model names; older names get retired periodically.
GEMINI_MODEL=gemini-flash-latest

# Max seconds to wait for audio file processing on Gemini
GEMINI_UPLOAD_TIMEOUT=120

# Flask
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
PORT=5000

# Accounts database (optional) — defaults to a local SQLite file if unset.
# Point this at Postgres (or another SQLAlchemy-supported database) to swap it in later.
# DATABASE_URL=postgresql://user:password@localhost:5432/meetmind

# File cleanup
FILE_RETENTION_MINUTES=60
CLEANUP_INTERVAL_SECONDS=300

# Rate limiting
RATELIMIT_DEFAULT=30 per hour;10 per minute

# Production (optional)
# USE_WAITRESS=true
# HOST=0.0.0.0
# PREFERRED_URL_SCHEME=https
# SESSION_COOKIE_SECURE=true
